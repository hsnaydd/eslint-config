{
  "name": "@hsnaydd/eslint-config",
  "version": "2.0.1",
  "description": "Shareable ESLint config for TypeScript, React, Next.js and Node.js, with Jest, Vitest and Storybook presets and Prettier formatting.",
  "keywords": [
    "eslint",
    "eslint-config",
    "eslintconfig",
    "flat-config",
    "typescript",
    "react",
    "nextjs",
    "node",
    "jest",
    "vitest",
    "storybook",
    "prettier"
  ],
  "author": "Hasan Aydoğdu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsnaydd/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/hsnaydd/eslint-config/issues"
  },
  "homepage": "https://github.com/hsnaydd/eslint-config#readme",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./base": "./base.js",
    "./jest": "./jest.js",
    "./storybook": "./storybook.js",
    "./react": "./react.js",
    "./next": "./next.js",
    "./node": "./node.js",
    "./vitest": "./vitest.js",
    "./package.json": "./package.json"
  },
  "files": [
    "*.js",
    "rules"
  ],
  "scripts": {
    "test": "node --test 'test/*.test.mjs'",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "storybook": "^10.2.9",
    "typescript": ">=6.0.0 <6.1.0"
  },
  "peerDependenciesMeta": {
    "jest": {
      "optional": true
    },
    "storybook": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.1",
    "eslint-plugin-jest-dom": "^5.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "^10.6.8",
    "eslint-plugin-testing-library": "^7.16.3",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.73.0"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "storybook": "^10.6.8",
    "typescript": "^6.0.3"
  }
}
